# ------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------
# 2. Build Outputs & Artifacts (All subfolders)
# ------------------------------------------------------
dist/
build/
out/
coverage/
.nyc_output/

# ------------------------------------------------------
# 3. Environment Variables (Security)
# ------------------------------------------------------
# Ignore all .env files
.env
.env.*
# BUT keep the example file so devs know what vars to set
!.env.example

# ------------------------------------------------------
# 4. OS & System Files
# ------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db

# ------------------------------------------------------
# 5. IDE & Editor Configs
# ------------------------------------------------------
.idea/
*.swp
*.swo

# VS Code: Ignore local user state, but keep project settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ------------------------------------------------------
# 6. Backend / Database Specifics
# ------------------------------------------------------
# Ignore actual SQLite database files (runtime data)
*.db
*.db-journal

# Logs and Process IDs
logs/
*.log
pids/
*.pid
*.pid.lock
*.seed

# Note: We are deliberately NOT ignoring 'prisma/migrations'. 
# Those MUST be committed.

# ------------------------------------------------------
# 7. Frontend / Vite Specifics
# ------------------------------------------------------
.vite/

# Note: We are deliberately NOT ignoring 'frontend/public'. 
# Static assets MUST be committed.
